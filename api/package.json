{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node ./dist/index.js",
    "dev": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} concurrently \"tsx watch --include 'src/assets/**' --include 'src/public/**' src/index.ts\" \"livereload --extraExts 'ts,svg,ttf' --wait 600\"",
    "build": "tsc && cp -r src/assets dist/",
    "test": "tsx --test 'test/**/*.test.ts'"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.1",
    "serverless-http": "^3.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/livereload": "^0.9.5",
    "concurrently": "^9.1.2",
    "livereload": "^0.9.3",
    "tsx": "^4.19.2",
    "typescript": "^4.7.4"
  }
}
